#!/usr/bin/env bash
# Builds the debug APK and puts it on the phone: over USB when adb sees one, otherwise over Taildrop.
set -euo pipefail
cd "$(dirname "$0")"

export JAVA_HOME="${JAVA_HOME:-/opt/android-studio/jbr}"
./gradlew -q :app:assembleDebug
apk=app/build/outputs/apk/debug/app-debug.apk
adb="$HOME/Android/Sdk/platform-tools/adb"

if "$adb" get-state >/dev/null 2>&1; then
  "$adb" install -r "$apk"
  "$adb" shell am start -n dev.muxmote/.MainActivity
  exit
fi

phone=$(tailscale status --json | jq -r '[.Peer[] | select(.OS == "android" and .Online)][0].DNSName // empty')
if [ -z "$phone" ]; then
  echo "No phone found: plug it in with USB debugging on, or turn on Tailscale on it." >&2
  exit 1
fi
phone=${phone%%.*}
echo "Sending to $phone. If it hangs, open Tailscale on the phone: it may be asking for a Taildrop folder."
tailscale file cp "$apk" "$phone:"
echo "Sent to $phone. On the phone, tap the Tailscale notification, then the APK."
